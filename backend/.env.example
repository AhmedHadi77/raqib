# Copy to backend/.env and edit.  (setup_windows.bat does the copy for you)

# ---------------- robot / MQTT
ROBOT_ID=robot01
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=backend
MQTT_PASSWORD=backend-secret
# true = start a small MQTT broker inside the backend (no Docker/Mosquitto needed, dev only)
EMBEDDED_BROKER=true
# MQTT_TLS=true
# MQTT_CA_CERT=../infra/certs/ca.crt

# ---------------- security (CHANGE THESE before any demo on a shared network)
JWT_SECRET=change-me-to-a-long-random-string
# Accounts created on the FIRST start only. After that, manage users in the app (Settings > Users)
# and change passwords there (Settings > Account).
USERS=admin:admin123:admin,operator:operator123:operator,viewer:viewer123:viewer

# ---------------- AI  (easiest: in the app, More > AI settings, paste a free Gemini key - it is saved here)
# Planner LLM: none (offline rule-based) | openai | gemini | ollama
LLM_PROVIDER=none
# Vision model: mock (uses the simulator's ground truth) | openai | gemini | ollama
VLM_PROVIDER=mock

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash

# Ollama runs models locally for free (you already have it installed): ollama pull llama3.1 ; ollama pull qwen2.5vl
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_VISION_MODEL=qwen2.5vl

# ---------------- memory
# auto | sentence-transformers | chroma-default | hash
EMBEDDING_BACKEND=auto

# ---- Voice commands (speech-to-text) ------------------------------------------
# auto = OpenAI key > Google key > local faster-whisper (install_voice.bat) > off
STT_PROVIDER=auto
STT_LANGUAGE=en
WHISPER_MODEL=base.en

# ---- Exam proctoring (Exam monitor) ---------------------------------------------
# auto = simulator > MediaPipe on this PC (upgrade.bat installs it) > vision AI ; or mediapipe | ai | off
PROCTOR_VISION=auto
# head turned more than 35 degrees for 3 s, or bowed more than 40 degrees for 8 s = flag
PROCTOR_HEAD_TURN_DEG=35
PROCTOR_HEAD_TURN_S=3
PROCTOR_LOOK_DOWN_DEG=40
PROCTOR_LOOK_DOWN_S=8
# seconds the camera watches each view (longer when something looks odd)
PROCTOR_DWELL_S=4
# drive up to a flagged student before speaking
PROCTOR_APPROACH=true

# ---- Product / site name shown in the app ---------------------------------------
PRODUCT_NAME=Raqib
SITE_NAME=Main Campus
