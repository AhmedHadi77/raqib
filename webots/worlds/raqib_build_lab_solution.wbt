#VRML_SIM R2025a utf8
# Raqib build lab (solution) - generated by webots/build_lab.py. Follow the Raqib build guide.

WorldInfo {
  info [ "The finished robot, built from the guide's steps" ]
  title "Raqib build lab (solution)"
  basicTimeStep 16
  contactProperties [ ContactProperties { material2 "caster" coulombFriction [ 0.02 ] } ]
}
Viewpoint {
  orientation -0.1782 0.4303 0.8849 0.8756
  position -1.4 -1.6 1.2
  fieldOfView 0.9
  near 0.02
}
Background { skyColor [ 0.78 0.82 0.88 ] luminosity 0.3 }
DirectionalLight { direction 0.3 0.5 -1 intensity 0.25 castShadows TRUE }
PointLight { location 1 0 2.6 intensity 1.6 radius 8 castShadows FALSE }
Solid { translation 1 0 -0.01 name "lab floor" children [ Shape { appearance PBRAppearance { baseColor 1 1 1 roughness 0.9 metalness 0.0 baseColorMap ImageTexture { url ["textures/lab_floor.png"] filtering 1 } } geometry Box { size 6.0 4.0 0.02 } } ] boundingObject Box { size 6.0 4.0 0.02 } }
Solid { translation 1 2 0.6 name "north wall" children [ Shape { appearance PBRAppearance { baseColor 0.86 0.88 0.92 roughness 0.8 metalness 0.0 } geometry Box { size 6 0.05 1.2 } } ] boundingObject Box { size 6 0.05 1.2 } }
Solid { translation 1 -2 0.6 name "south wall" children [ Shape { appearance PBRAppearance { baseColor 0.86 0.88 0.92 roughness 0.8 metalness 0.0 } geometry Box { size 6 0.05 1.2 } } ] boundingObject Box { size 6 0.05 1.2 } }
Solid { translation 4 0 0.6 name "east wall" children [ Shape { appearance PBRAppearance { baseColor 0.86 0.88 0.92 roughness 0.8 metalness 0.0 } geometry Box { size 0.05 4 1.2 } } ] boundingObject Box { size 0.05 4 1.2 } }
Solid { translation -2 0 0.6 name "west wall" children [ Shape { appearance PBRAppearance { baseColor 0.86 0.88 0.92 roughness 0.8 metalness 0.0 } geometry Box { size 0.05 4 1.2 } } ] boundingObject Box { size 0.05 4 1.2 } }
Solid { translation 3.97 0 1.05 rotation 0.5774 -0.5774 -0.5774 2.0944 name "camera test card" children [ Shape { appearance PBRAppearance { baseColor 1 1 1 roughness 0.6 metalness 0.0 baseColorMap ImageTexture { url ["textures/lab_testcard.png"] filtering 1 } } geometry Plane { size 1.0 0.7 } } ] }
Solid { translation 1.6 0 0.15 name "cardboard box" children [ Shape { appearance PBRAppearance { baseColor 0.72 0.55 0.36 roughness 0.8 metalness 0.0 } geometry Box { size 0.2 0.4 0.3 } } ] boundingObject Box { size 0.2 0.4 0.3 } }
Solid { translation 1.3 1.25 0 rotation 0 0 1 -2.2 name "chair" children [ Pose { translation 0 0 0.47 children [ Shape { appearance PBRAppearance { baseColor 0.15 0.2 0.55 roughness 0.8 metalness 0.0 } geometry Box { size 0.45 0.45 0.05 } } ] } Pose { translation -0.22 0 0.75 children [ Shape { appearance PBRAppearance { baseColor 0.15 0.2 0.55 roughness 0.8 metalness 0.0 } geometry Box { size 0.05 0.45 0.5 } } ] } Pose { translation 0 0 0.24 children [ Shape { appearance PBRAppearance { baseColor 0.3 0.3 0.3 roughness 0.3 metalness 0.7 } geometry Cylinder { height 0.42 radius 0.025 } } ] } Pose { translation 0 0 0.03 children [ Shape { appearance PBRAppearance { baseColor 0.2 0.2 0.2 roughness 0.8 metalness 0.0 } geometry Box { size 0.5 0.06 0.03 } } ] } Pose { translation 0 0 0.03 children [ Shape { appearance PBRAppearance { baseColor 0.2 0.2 0.2 roughness 0.8 metalness 0.0 } geometry Box { size 0.06 0.5 0.03 } } ] } ] boundingObject Pose { translation -0.02 0 0.5 children [ Box { size 0.5 0.5 1 } ] } }
Pose { translation 0 0 0.001 children [ Shape { appearance PBRAppearance { baseColor 0.24 0.39 1 roughness 0.8 metalness 0.0 emissiveColor 0.05 0.1 0.3 } geometry Cylinder { height 0.001 radius 0.03 } } ] }
DEF RAQIB Robot {
  translation 0 0 0
  name "raqib"
  controller "<extern>"
  supervisor TRUE
  children [
    # STEP 2 - chassis: the base plate everything is screwed to. 26 x 11 x 6 cm, bottom 3.5 cm above the floor.
    Pose {
      translation 0 0 0.065
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.08 0.3 0.55 roughness 0.5 metalness 0 }
          geometry Box { size 0.26 0.11 0.06 }
        }
      ]
    }
    # STEP 3 - drive wheels: 65 mm wheels, 15 cm apart (wheel_base_m in config.yaml), each with a motor and an encoder.
    HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor 0 0.075 0.0325 }
      device [
        RotationalMotor { name "left wheel motor" maxVelocity 17.7 maxTorque 2 acceleration 25 }
        PositionSensor { name "left wheel sensor" }
      ]
      endPoint Solid {
        translation 0 0.075 0.0325
        rotation 1 0 0 1.5708
        name "left wheel"
        children [
          Shape {
            appearance PBRAppearance { baseColor 0.08 0.08 0.08 roughness 0.9 metalness 0 }
            geometry Cylinder { height 0.026 radius 0.0325 subdivision 24 }
          }
        ]
        boundingObject Cylinder { height 0.026 radius 0.0325 }
        physics Physics { density -1 mass 0.06 }
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor 0 -0.075 0.0325 }
      device [
        RotationalMotor { name "right wheel motor" maxVelocity 17.7 maxTorque 2 acceleration 25 }
        PositionSensor { name "right wheel sensor" }
      ]
      endPoint Solid {
        translation 0 -0.075 0.0325
        rotation 1 0 0 1.5708
        name "right wheel"
        children [
          Shape {
            appearance PBRAppearance { baseColor 0.08 0.08 0.08 roughness 0.9 metalness 0 }
            geometry Cylinder { height 0.026 radius 0.0325 subdivision 24 }
          }
        ]
        boundingObject Cylinder { height 0.026 radius 0.0325 }
        physics Physics { density -1 mass 0.06 }
      }
    }
    # STEP 4 - ball casters front and back keep the chassis level (the real 4WD kit uses its second pair of wheels).
    Solid {
      translation 0.1 0 0.016
      name "front caster"
      contactMaterial "caster"
      children [ Shape { appearance PBRAppearance { baseColor 0.7 0.7 0.72 roughness 0.2 metalness 0.8 } geometry Sphere { radius 0.016 } } ]
      boundingObject Sphere { radius 0.016 }
      physics Physics { density -1 mass 0.01 }
    }
    Solid {
      translation -0.1 0 0.016
      name "rear caster"
      contactMaterial "caster"
      children [ Shape { appearance PBRAppearance { baseColor 0.7 0.7 0.72 roughness 0.2 metalness 0.8 } geometry Sphere { radius 0.016 } } ]
      boundingObject Sphere { radius 0.016 }
      physics Physics { density -1 mass 0.01 }
    }
    # STEP 5 - top deck with the electronics: battery low in the chassis, Raspberry Pi + UPS hat and driver boards on top.
    Pose {
      translation 0 0 0.101
      children [ Shape { appearance PBRAppearance { baseColor 0.12 0.78 0.89 roughness 0.4 metalness 0 } geometry Box { size 0.2 0.105 0.012 } } ]
    }
    Pose {
      translation -0.06 0 0.122
      children [ Shape { appearance PBRAppearance { baseColor 0.1 0.45 0.2 roughness 0.6 metalness 0 } geometry Box { size 0.085 0.056 0.03 } } ]
    }
    Pose {
      translation 0.045 0 0.113
      children [ Shape { appearance PBRAppearance { baseColor 0.15 0.2 0.55 roughness 0.6 metalness 0 } geometry Box { size 0.043 0.043 0.012 } } ]
    }
    # STEP 6 - three HC-SR04 ultrasonic sensors, 7 cm high: centre straight ahead, left and right turned 45 degrees.
    # lookupTable turns metres into centimetres: 0.02 m -> 2, 4 m -> 400 (nothing in range).
    DistanceSensor {
      translation 0.12 0 0.07
      name "us_center"
      type "sonar"
      numberOfRays 5
      aperture 0.26
      lookupTable [ 0.02 2 0, 4 400 0 ]
      children [ Shape { appearance PBRAppearance { baseColor 0.1 0.35 0.7 roughness 0.5 metalness 0 } geometry Box { size 0.008 0.045 0.02 } } ]
    }
    DistanceSensor {
      translation 0.085 0.068 0.07
      rotation 0 0 1 0.7854
      name "us_left"
      type "sonar"
      numberOfRays 5
      aperture 0.26
      lookupTable [ 0.02 2 0, 4 400 0 ]
      children [ Shape { appearance PBRAppearance { baseColor 0.1 0.35 0.7 roughness 0.5 metalness 0 } geometry Box { size 0.008 0.045 0.02 } } ]
    }
    DistanceSensor {
      translation 0.085 -0.068 0.07
      rotation 0 0 1 -0.7854
      name "us_right"
      type "sonar"
      numberOfRays 5
      aperture 0.26
      lookupTable [ 0.02 2 0, 4 400 0 ]
      children [ Shape { appearance PBRAppearance { baseColor 0.1 0.35 0.7 roughness 0.5 metalness 0 } geometry Box { size 0.008 0.045 0.02 } } ]
    }
    # STEP 7 - MPU6050 motion sensor: flat, at the centre of the chassis. Webots splits it into three devices.
    InertialUnit { name "imu" }
    Gyro { name "gyro" }
    Accelerometer { name "accelerometer" }
    # STEP 8 - 1 m mast with the pan/tilt servos and the Pi Camera on top (camera lens at 1.05 m).
    Pose {
      translation 0 0 0.545
      children [ Shape { appearance PBRAppearance { baseColor 0.75 0.76 0.8 roughness 0.3 metalness 0.8 } geometry Cylinder { height 0.89 radius 0.012 } } ]
    }
    HingeJoint {
      jointParameters HingeJointParameters { axis 0 0 1 anchor 0 0 1.02 }
      device [
        RotationalMotor { name "pan motor" minPosition -1.6 maxPosition 1.6 maxVelocity 6 }
        PositionSensor { name "pan sensor" }
      ]
      endPoint Solid {
        translation 0 0 1.02
        name "pan base"
        children [
          Shape { appearance PBRAppearance { baseColor 0.12 0.12 0.14 roughness 0.6 metalness 0 } geometry Cylinder { height 0.03 radius 0.035 } }
          HingeJoint {
            jointParameters HingeJointParameters { axis 0 1 0 anchor 0 0 0.03 }
            device [
              RotationalMotor { name "tilt motor" minPosition -0.8 maxPosition 1.05 maxVelocity 6 }
              PositionSensor { name "tilt sensor" }
            ]
            endPoint Solid {
              translation 0 0 0.03
              name "tilt head"
              children [
                Shape { appearance PBRAppearance { baseColor 0.12 0.12 0.14 roughness 0.6 metalness 0 } geometry Box { size 0.05 0.1 0.035 } }
                Camera { translation 0.035 0 0 name "camera" fieldOfView 1.0856 width 640 height 480 far 25 }
              ]
            }
          }
        ]
      }
    }
    # STEP 9 - speaker (PAM8403 amplifier + small speaker) for spoken replies and exam warnings.
    Speaker { name "speaker" }
    # >>> paste the next step's parts here <<<
  ]
  boundingObject Pose { translation 0 0 0.065 children [ Box { size 0.26 0.11 0.06 } ] }
  physics Physics { density -1 mass 1.6 centerOfMass [ 0 0 0.04 ] }
}
